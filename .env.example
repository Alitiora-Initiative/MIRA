# Solana Mainnet RPC (Helius / QuickNode / Triton recommended)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Base58-encoded private key of the core wallet (NEVER commit the real .env)
PRIVATE_KEY=

# Optional: Jupiter API key if using rate-limited endpoints
JUPITER_API_KEY=

# Trading parameters
MIN_BALANCE_USD=0.60
MITOSIS_TRIGGER_USD=20.00
SUB_AGENT_COUNT=15
SUB_AGENT_ALLOCATION_USD=1.00
PARENT_GAS_RESERVE_USD=5.00
PRIORITY_FEE_LAMPORTS=50000
TRADE_SIZE_SOL=0.001
